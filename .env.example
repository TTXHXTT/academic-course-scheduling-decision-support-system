# ACS Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to source control

APP_NAME=Academic Course Scheduling Decision-Support System
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Database Configuration (SPMP Section 3 & SRS Section 2.6)
# Local Development (SQLite):
DATABASE_URL=sqlite:///./acs_dev.db

# Cloud Production / Neon PostgreSQL (Group 5 baseline per SPMP Section 3):
# DATABASE_URL=postgresql://<user>:<password>@<ep-proj-name>.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local Docker PostgreSQL:
# DATABASE_URL=postgresql://acs_user:CHANGE_ME@localhost:5432/acs_db

# MUST change in production
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=http://localhost:8000
MAX_UPLOAD_SIZE_BYTES=52428800

# Analytics thresholds (prototype assumptions, not CSUSB policies)
HIGH_UTILIZATION_THRESHOLD=85.0
LOW_UTILIZATION_THRESHOLD=50.0
FREQUENTLY_FULL_THRESHOLD=0.50
INCREASING_DEMAND_SLOPE=2.0
MIN_TERMS_FOR_TREND=2
FULL_CAPACITY_THRESHOLD=0.95
ANALYTICS_METHOD_VERSION=1.0.0

POSTGRES_USER=acs_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=acs_db
